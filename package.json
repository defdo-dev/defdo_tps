{
  "name": "defdo-tps",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "exports": {
    "./opencode/tui": {
      "import": "./opencode/tui.tsx"
    },
    "./kimi/statusline": {
      "import": "./kimi/statusline.ts"
    }
  },
  "scripts": {
    "build:kimi": "bun build kimi/statusline.ts --compile --outfile $HOME/.kimi-code/defdo-tps-statusline",
    "verify:opencode": "bun build opencode/tui.tsx --target bun --format esm --external '@opentui/solid' --external '@opencode-ai/plugin/tui' --external 'solid-js' --outfile /tmp/defdo-tps-opencode.js",
    "build:pi": "bun build pi-extension.ts --target bun --format cjs --outfile ./build/pi-extension.js",
    "test": "bun test"
  }
}
